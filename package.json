{
  "name": "agi-os",
  "version": "1.5.0",
  "private": true,
  "description": "AGI Operating System - A zero-cost, generalizing autonomous system",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "dashboard": "pnpm --filter @agi-os/dashboard dev",
    "dashboard:build": "pnpm --filter @agi-os/dashboard build",
    "mission:golden": "pnpm --filter @agi-os/certification test -- tests/missions/MISSION-001.test.ts"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
