# ============================================================================
# AGI OS — Environment Configuration
# Copy to .env and customize as needed
# ============================================================================

# --- Cost Enforcement ---
# Hard limit: $0 means zero cloud spend. NEVER change in production.
MAX_SPEND=0

# --- Ollama Local LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# --- Dashboard ---
PORT=3000
NODE_ENV=production

# --- Logging ---
LOG_LEVEL=info

# --- Governance ---
# Approval timeout in milliseconds (default: 5 minutes)
APPROVAL_TIMEOUT_MS=300000

# --- Memory ---
# Vector memory persistence path (Docker: /app/data, local: ./data)
MEMORY_DATA_PATH=./data

# --- Event Loop ---
# Max iterations per loop cycle
LOOP_MAX_ITERATIONS=100
# Idle delay between iterations (ms)
LOOP_IDLE_DELAY_MS=1000
